# Enable URL Rewriting (works at domain root on Hostinger and in local subfolders)
RewriteEngine On

# --- Canonical host: HTTPS + non-www (https://nazora.tech) ---
# REQUEST_URI keeps the path; Apache/LiteSpeed appends the original query string.
# X-Forwarded-Proto covers Hostinger reverse-proxy TLS termination.
RewriteCond %{HTTP_HOST} ^(www\.)?nazora\.tech$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://nazora.tech%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.nazora\.tech$ [NC]
RewriteRule ^ https://nazora.tech%{REQUEST_URI} [R=301,L]

# Private paths: database, backups, enquiry logs, PHP includes, Composer vendor. Uploaded images stay public.
RewriteRule ^storage/(?!uploads/) - [F,L]
RewriteRule ^storage/uploads/.*\.(php\d?|phtml|phar|cgi|pl|sh)$ - [F,L,NC]
RewriteRule ^(submissions|includes|vendor)(/|$) - [F,L]

# --- Homepage duplicates: /index and /index.php → directory root (/ or /subfolder/) ---
# Uses THE_REQUEST so internal rewrites to index.php are not redirected in a loop.
# Capture optional subdirectory prefix so local XAMPP paths keep working.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index(?:\.php)?(?:[\s?]|$) [NC]
RewriteRule ^index(?:\.php)?/?$ /%1 [R=301,L]

# Blog routes, sitemap, robots
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog_details.php?slug=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^robots\.txt$ robots.php [L]

# Remove trailing slash if not a directory (preserves directory prefix automatically)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+?)/+$
RewriteRule ^ %1 [R=301,L]

# Redirect GET *.php requests to clean URLs
RewriteCond %{THE_REQUEST} ^GET\ .+\.php[\s?]
RewriteCond %{REQUEST_URI} ^(.+)\.php$
RewriteRule \.php$ %1 [R=301,L]

# Serve clean URLs from matching .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Return custom 404 page (real HTTP 404) for any non-existent path
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]

ErrorDocument 404 /404.php

# Disable directory browsing
Options -Indexes

# Never serve dotfiles, databases, backups, docs, config templates, or build files
<FilesMatch "(^\.|\.(sqlite3?(?:-(?:wal|shm|journal))?|db|log|md|zip|bak|sql|ini|env|lock|dist)$|^Dockerfile$|^composer\.(json|lock)$|^config\.local(?:\.example)?\.php$|^nazora-config\.php$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Report-Only CSP first: restricts framing, base-uri, form-action and objects without breaking fonts, scripts, or GA4
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdn.ckeditor.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Set default character encoding
AddDefaultCharset UTF-8

# Compression and caching when supported by Apache / LiteSpeed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
